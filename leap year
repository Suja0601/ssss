#include<stdio.h>
int main()
{
int year;
printf("Enter A Year to find leap or not\n ");
scanf("%d",&year);
if (year%4==0)
{
  printf("%d is a leap year\n",year);
}
else
{
   printf("%d is not a leap year\n",year); 
}
printf("\n");
return 0;
}
