#include <stdio.h>
int main()
{
    int i, n, sum = 0, digit;
    printf("Enter a number to check Armstrong\n");
    scanf("%d",&n);
    i = n;
    while (n > 0)
    {
        digit = n % 10;
        sum = sum + (digit * digit * digit);
        n = n / 10;
    }
    if (sum == i)
    {
        printf("%d is armstrong\n",i);
    }
    else
    {
        printf("%d Is Not Armstrong\n",i);
    }

    return 0;
}
