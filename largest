#include<stdio.h>
int main()
{
int a,b,c,i;
printf("Enter Three Numbers To find the largest:\n");
scanf("%d %d %d", &a,&b,&c);
i= (a>b)?((a>c)?a:c):((b>c)?b:c);  
printf("\n%d is The  largest Number \n",i); 
printf("\n");
return 0;
}
