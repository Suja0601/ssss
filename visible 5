#include <stdio.h>
int main()
{
    int i, n, sum = 0;
    printf("Enter a number between 100-200,to find sum of all number divisible by 5\n");
    scanf("%d", &n);
    if (n < 100 || n > 200)
    {
        printf("Entered Number Is invalid");
        return 1;
    }

    for (i = 100; i <= n; i++)
    {
        if (i % 5 == 0)
        {
            sum = sum + i;
        }
    }
    printf("Sum= %d", sum);

    return 0;
}
